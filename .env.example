# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL (Serverless Postgres 15)
DATABASE_URL="postgres://user:password@ep-cool-name-123456.eu-central-1.aws.neon.tech/cransys?sslmode=require"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Cloudflare R2 Blob Storage
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="cransys-audit-reports"

# Upstash Redis (Rate Limiter & Queue)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# ЮKassa Payments
YOOKASSA_SHOP_ID="your_shop_id"
YOOKASSA_SECRET_KEY="your_secret_key"

# Почтовый сервис (Яндекс SMTP для cransys@yandex.ru)
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="cransys@yandex.ru"
SMTP_PASS="your_yandex_app_password_here"
SMTP_FROM="Cransys <cransys@yandex.ru>"

# Яндекс OAuth для прямого подключения к API Яндекс.Директ
YANDEX_CLIENT_ID="your_yandex_oauth_client_id"
YANDEX_CLIENT_SECRET="your_yandex_oauth_client_secret"
YANDEX_REDIRECT_URI="https://cransys.vercel.app/api/direct/callback"

# Тестовый аккаунт для ручной проверки (PRO / MAX / White-label)
TEST_USER_EMAIL="test-owner@cransys-audit.ru"
TEST_USER_PASSWORD="CransysTest2026!"

# Главный администратор платформы (/admin)
ADMIN_EMAIL="admin@cransys.ru"
ADMIN_PASSWORD="AdminCransys2026!"
